# Generated by `UPDATE_DOCKERFILES=1 go test github.com/Sili-Sudoku/api/libs/boundary -run Dockerfiles`. Do not edit.
# Builds the program in services/puzzles. Context: the api/ directory. Only the modules in its go.work are copied, so the image
# cannot depend on anything else. Dependencies are downloaded before the code is copied, so they stay cached.
FROM golang:1.27 AS build
WORKDIR /opt/src/project

COPY ./libs/boot/go.mod ./libs/boot/go.mod
COPY ./libs/boot/go.sum ./libs/boot/go.sum
COPY ./libs/clientip/go.mod ./libs/clientip/go.mod
COPY ./libs/cursor/go.mod ./libs/cursor/go.mod
COPY ./libs/db/go.mod ./libs/db/go.mod
COPY ./libs/db/go.sum ./libs/db/go.sum
COPY ./libs/dbtest/go.mod ./libs/dbtest/go.mod
COPY ./libs/dbtest/go.sum ./libs/dbtest/go.sum
COPY ./libs/http_outcome/go.mod ./libs/http_outcome/go.mod
COPY ./libs/mockprovider/go.mod ./libs/mockprovider/go.mod
COPY ./libs/ratelimit/go.mod ./libs/ratelimit/go.mod
COPY ./libs/server/go.mod ./libs/server/go.mod
COPY ./libs/stack_trace/go.mod ./libs/stack_trace/go.mod
COPY ./libs/validate/go.mod ./libs/validate/go.mod
COPY ./migrations/go.mod ./migrations/go.mod
COPY ./services/accounts/model/go.mod ./services/accounts/model/go.mod
COPY ./services/accounts/postgres/go.mod ./services/accounts/postgres/go.mod
COPY ./services/accounts/postgres/go.sum ./services/accounts/postgres/go.sum
COPY ./services/accounts/session/go.mod ./services/accounts/session/go.mod
COPY ./services/community/model/go.mod ./services/community/model/go.mod
COPY ./services/history/model/go.mod ./services/history/model/go.mod
COPY ./services/puzzles/go.mod ./services/puzzles/go.mod
COPY ./services/puzzles/go.work.sum ./services/puzzles/go.work.sum
COPY ./services/puzzles/model/go.mod ./services/puzzles/model/go.mod
COPY ./services/puzzles/postgres/go.mod ./services/puzzles/postgres/go.mod
COPY ./services/puzzles/postgres/go.sum ./services/puzzles/postgres/go.sum
COPY ./services/puzzles/go.work ./services/puzzles/go.work

WORKDIR /opt/src/project/services/puzzles
RUN go mod download

WORKDIR /opt/src/project
COPY ./libs/boot ./libs/boot
COPY ./libs/clientip ./libs/clientip
COPY ./libs/cursor ./libs/cursor
COPY ./libs/db ./libs/db
COPY ./libs/dbtest ./libs/dbtest
COPY ./libs/http_outcome ./libs/http_outcome
COPY ./libs/mockprovider ./libs/mockprovider
COPY ./libs/ratelimit ./libs/ratelimit
COPY ./libs/server ./libs/server
COPY ./libs/stack_trace ./libs/stack_trace
COPY ./libs/validate ./libs/validate
COPY ./migrations ./migrations
COPY ./services/accounts/model ./services/accounts/model
COPY ./services/accounts/postgres ./services/accounts/postgres
COPY ./services/accounts/session ./services/accounts/session
COPY ./services/community/model ./services/community/model
COPY ./services/history/model ./services/history/model
COPY ./services/puzzles ./services/puzzles

WORKDIR /opt/src/project/services/puzzles
RUN CGO_ENABLED=0 go build -o /out/app .

# Node 24 plus the bundled validate-puzzle tool (a single file; it needs nothing else). The release script puts it in
# dist-tools/ first (in web/: npm run build:validator, then copy web/dist-tools/validate-puzzle here). Without it the
# program would accept every puzzle, so REQUIRE_VALIDATOR=true makes it refuse to start.
FROM node:24-slim
COPY --from=build /out/app /app
COPY dist-tools/validate-puzzle /usr/local/bin/validate-puzzle
ENV VALIDATE_CMD=/usr/local/bin/validate-puzzle
USER node
ENTRYPOINT ["/app"]
