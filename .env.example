# Address a program listens on (dev: accounts 8081, puzzles 8082, community 8083, history 8084; Caddy is on 8080).
API_ADDR=:8080
# Postgres connection URL. Required.
DATABASE_URL=
# Path to the validate-puzzle tool built from the web repo. Empty = accept every puzzle (dev only).
VALIDATE_CMD=
# "true" drops the Secure flag from the session cookie. Browsers send Secure cookies to http://localhost,
# so leave it unset unless you open the dev site through another host name.
COOKIE_INSECURE=
# "true" reads the client address (for rate limits) from X-Forwarded-For. Only behind a proxy that sets it.
TRUST_PROXY=
